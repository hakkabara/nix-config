+    // Privacy mode (media-privacy) applies live: when the flag appears or
+    // disappears, resend the metadata of every player, so the peers switch
+    // between "Privat" and the real title without a reconnect.
+    const QString privacyDir = QStandardPaths::writableLocation(QStandardPaths::GenericStateLocation) + QStringLiteral("/kdeconnect-media");
+    QDir().mkpath(privacyDir);
+    auto *privacyWatcher = new QFileSystemWatcher({privacyDir}, this);
+    connect(privacyWatcher, &QFileSystemWatcher::directoryChanged, this, [this]() {
+        for (auto it = playerList.constBegin(); it != playerList.constEnd(); ++it) {
+            NetworkPacket np(PACKET_TYPE_MPRIS);
+            mprisPlayerMetadataToNetworkPacket(np, it.value().mediaPlayer2PlayerInterface()->metadata());
+            np.set(QStringLiteral("player"), it.key());
+            sendPacket(np);
+        }
+    });
 }
 
