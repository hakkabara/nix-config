set -euo pipefail

readonly SETTINGS="${DEPLOYMENT_SETTINGS:?DEPLOYMENT_SETTINGS is not set}"

BUILD_REPOSITORY="$(jq --raw-output '.buildRepository' "$SETTINGS")"
REPO_PATH="$(jq --raw-output '.repoDir' "$SETTINGS")/$BUILD_REPOSITORY"
readonly BUILD_REPOSITORY REPO_PATH

# Inputs fetched over SSH (for example nix-config from the internal Forgejo)
# use the DeployVM-local identity, scoped to the Forgejo host names by the
# generated ssh config. The user's global Git config (insteadOf rewrites to
# GitHub SSH) is ignored for every nix call, like for the checkouts.
export GIT_CONFIG_GLOBAL=/dev/null

if [ "$(jq --raw-output '.ssh != null' "$SETTINGS")" = true ]; then
    GIT_SSH_COMMAND="ssh -F $(jq --raw-output '.ssh.configFile' "$SETTINGS")"
    export GIT_SSH_COMMAND
fi

usage() {
    echo "Usage: deploy-build <host>" >&2
    echo "Example: deploy-build work-vm" >&2
}

if [ "$#" -ne 1 ]; then
    usage
    exit 2
fi

HOST="$1"

case "$HOST" in
    ""|*[!a-z0-9-]*)
        echo "ERROR: invalid host name: $HOST" >&2
        exit 1
        ;;
esac

git_public() {
    GIT_CONFIG_GLOBAL=/dev/null git "$@"
}

echo "============================================================"
echo " DEPLOY BUILD"
echo "============================================================"

echo
echo "Host:       $HOST"
echo "Flake:      $BUILD_REPOSITORY"
echo "Repository: $REPO_PATH"

echo
echo "===== PRECHECK ====="

if [ ! -d "$REPO_PATH/.git" ]; then
    echo "ERROR: managed repository does not exist."
    echo "Run deploy-repo-sync first."
    exit 1
fi

cd "$REPO_PATH"

if [ -n "$(git_public status --porcelain)" ]; then
    echo "ERROR: managed repository is dirty."
    exit 1
fi

echo "PASS: managed repository is clean"

# The lock file is used exactly as committed (--no-update-lock-file fails
# on any missing or outdated entry). Updating inputs here would build
# something that exists in no repository; bump locks where they are pushed
# from.
if [ ! -f flake.lock ]; then
    echo "ERROR: flake.lock is missing; inputs would not be pinned."
    exit 1
fi

echo "PASS: flake.lock present, inputs are used as locked"

BRANCH="$(git_public branch --show-current)"
COMMIT="$(git_public rev-parse --short HEAD)"

echo
echo "===== SOURCE ====="
echo "Branch: $BRANCH"
echo "Commit: $COMMIT"

echo
echo "===== TARGET VALIDATION ====="

TARGET_ATTR=".#nixosConfigurations.${HOST}.config.system.build.toplevel"

if ! EVALUATED_HOST="$(
    nix eval \
        --no-update-lock-file \
        --raw \
        ".#nixosConfigurations.${HOST}.config.networking.hostName"
)"; then
    echo
    echo "ERROR: host '$HOST' does not exist in the flake."
    exit 1
fi

if [ "$EVALUATED_HOST" != "$HOST" ]; then
    echo "ERROR: requested host '$HOST' evaluates to hostname '$EVALUATED_HOST'."
    exit 1
fi

echo "PASS: host exists in flake"
echo "Attribute: $TARGET_ATTR"

echo
echo "===== BUILD ====="

SYSTEM_PATH="$(
    nix build \
        "$TARGET_ATTR" \
        --no-update-lock-file \
        --no-link \
        --print-out-paths
)"

case "$SYSTEM_PATH" in
    /nix/store/*)
        ;;
    *)
        echo "ERROR: build returned unexpected path: $SYSTEM_PATH"
        exit 1
        ;;
esac

if [ ! -e "$SYSTEM_PATH" ]; then
    echo "ERROR: resulting store path does not exist."
    exit 1
fi

echo
echo "===== BUILD RESULT ====="
echo "$SYSTEM_PATH"

echo
echo "===== CLOSURE ====="

CLOSURE_COUNT="$(
    nix path-info \
        --recursive \
        "$SYSTEM_PATH" \
        | wc -l \
        | tr -d '[:space:]'
)"

if [ "$CLOSURE_COUNT" -lt 1 ]; then
    echo "ERROR: closure is empty."
    exit 1
fi

echo "Closure paths: $CLOSURE_COUNT"

nix path-info \
    --closure-size \
    --human-readable \
    "$SYSTEM_PATH"

echo
echo "PASS: closure is available"

CURRENT_ROOT="/nix/var/nix/gcroots/hakkabara/${HOST}/current"
PREVIOUS_ROOT="/nix/var/nix/gcroots/hakkabara/${HOST}/previous"

echo
echo "===== EXISTING PINS ====="

if [ -L "$CURRENT_ROOT" ]; then
    echo "Current:  $(readlink -f "$CURRENT_ROOT")"
else
    echo "Current:  none"
fi

if [ -L "$PREVIOUS_ROOT" ]; then
    echo "Previous: $(readlink -f "$PREVIOUS_ROOT")"
else
    echo "Previous: none"
fi

echo
echo "===== PIN ====="

/run/wrappers/bin/sudo /run/current-system/sw/bin/deploy-cache-pin \
    "$HOST" \
    "$SYSTEM_PATH"

echo
echo "===== VERIFY PIN ====="

if [ ! -L "$CURRENT_ROOT" ]; then
    echo "ERROR: current GC root was not created."
    exit 1
fi

PINNED_PATH="$(readlink -e "$CURRENT_ROOT")"

echo "Pinned: $PINNED_PATH"

if [ "$PINNED_PATH" != "$SYSTEM_PATH" ]; then
    echo "ERROR: pinned path does not match build result."
    exit 1
fi

echo "PASS: build result is protected by GC root"

echo
echo "===== FLAKE INPUTS ====="

# Every input source (recursively, including this flake itself) must stay
# in the store: offline clients substitute them from the cache to evaluate
# the flake.
ARCHIVE_JSON="$(nix flake archive --no-update-lock-file --json)"

mapfile -t INPUT_PATHS < <(
    jq --raw-output 'def paths: .path, (.inputs // {} | .[] | paths); paths' <<<"$ARCHIVE_JSON" | sort -u
)

if [ "${#INPUT_PATHS[@]}" -lt 2 ]; then
    echo "ERROR: flake archive returned ${#INPUT_PATHS[@]} paths; expected the flake and its inputs."
    exit 1
fi

echo "Input sources: ${#INPUT_PATHS[@]}"

/run/wrappers/bin/sudo /run/current-system/sw/bin/deploy-cache-pin-inputs \
    "$HOST" \
    "${INPUT_PATHS[@]}"

INPUTS_ROOT="/nix/var/nix/gcroots/hakkabara/${HOST}/inputs"

for input_path in "${INPUT_PATHS[@]}"; do
    if [ "$(readlink -e "$INPUTS_ROOT/$(basename "$input_path")")" != "$input_path" ]; then
        echo "ERROR: input source is not pinned: $input_path"
        exit 1
    fi
done

echo "PASS: all input sources are protected by GC roots"

echo
echo "===== RESULT ====="
echo "Host:   $HOST"
echo "Flake:  $BUILD_REPOSITORY"
echo "Commit: $COMMIT"
echo "System: $SYSTEM_PATH"
echo "Inputs: ${#INPUT_PATHS[@]} pinned"

echo
echo "============================================================"
echo " BUILD AND PIN PASSED"
echo " No target system was activated."
echo "============================================================"
