set -euo pipefail

echo "============================================================"
echo " DEPLOYMENT STATUS"
echo "============================================================"

echo
echo "===== HOST ====="
hostname

echo
echo "===== NIX ====="
nix --version

echo
echo "===== SYSTEM GENERATION ====="
readlink -f /run/current-system

echo
echo "===== NIX STORE ====="
df -h /nix

echo
echo "===== DEPLOYMENT LAN ====="

if ip addr show ens37 >/dev/null 2>&1; then
    echo "PASS: deployment interface exists"
    ip -4 addr show dev ens37
else
    echo "FAIL: deployment interface missing"
fi

echo
echo "===== HARMONIA ====="

if systemctl is-active --quiet harmonia.socket; then
    echo "PASS: Harmonia active"
else
    echo "FAIL: Harmonia inactive"
fi

echo
echo "===== MANAGED REPOSITORIES ====="

settings="${DEPLOYMENT_SETTINGS:?DEPLOYMENT_SETTINGS is not set}"
repo_dir="$(jq --raw-output '.repoDir' "$settings")"

echo "Build flake: $(jq --raw-output '.buildRepository' "$settings")"

while read -r name; do
    repo="$repo_dir/$name"

    echo
    if [ -d "$repo/.git" ]; then
        echo "PASS: $name"
        echo "Path:   $repo"

        printf 'Branch: '
        GIT_CONFIG_GLOBAL=/dev/null git -C "$repo" branch --show-current

        printf 'Commit: '
        GIT_CONFIG_GLOBAL=/dev/null git -C "$repo" rev-parse --short HEAD
    else
        echo "INFO: $name not initialized yet (deploy-repo-sync)"
    fi
done < <(jq --raw-output '.repositories | keys[]' "$settings")

echo
echo "===== CACHE ROOTS ====="

if [ -d /nix/var/nix/gcroots/hakkabara ]; then
    # System generations as links, input sets as counts.
    find \
        /nix/var/nix/gcroots/hakkabara \
        -mindepth 2 -maxdepth 2 \
        -type l \
        -printf "%p -> %l\n" \
        2>/dev/null \
        | sort

    find \
        /nix/var/nix/gcroots/hakkabara \
        -mindepth 2 -maxdepth 2 \
        -type d \
        -name 'inputs*' \
        2>/dev/null \
        | sort \
        | while read -r dir; do
            echo "$dir: $(find "$dir" -mindepth 1 -maxdepth 1 -type l | wc -l) input sources"
        done
else
    echo "No DeployVM roots found"
fi

echo
echo "===== FAILED UNITS ====="

systemctl --failed --no-pager || true
