# aic_usage: Help-Text (Grundgeruest, wird in US-011 erweitert).
aic_usage() {
  cat <<'EOF'
abuseipdb-check — read-only IP-Reputationspruefung gegen AbuseIPDB.

VERWENDUNG:
  abuseipdb-check [OPTIONEN] [IP ...]

BEISPIELE (alle vier Eingabewege):
  abuseipdb-check 1.2.3.4 5.6.7.8            # Weg 1: IPs als Positionsargumente
  abuseipdb-check -f ips.txt                 # Weg 2: IP-Liste aus Datei (-f/--file)
  cat text.log | abuseipdb-check             # Weg 3: IPs ueber stdin-Pipe
  cat text.log | abuseipdb-check --extract   # Weg 4: IPs aus Fliesstext extrahieren

EINGABE:
  -f, --file DATEI       IPs aus Datei lesen (eine/Zeile, # Kommentare, Leerzeilen ignoriert)
      IP ...             IPs direkt als Argumente
      (stdin)            IPs ueber Pipe (nur wenn kein Terminal)
      --extract          IPs aus unstrukturiertem Fliesstext herausfischen

WHITELIST / EXCLUDE:
      --exclude IP|CIDR      vom Check ausnehmen (wiederholbar; IPv4/IPv6, CIDR)
      --exclude-file DATEI   Ausschlussliste aus Datei (Kommentare erlaubt)

KONFIGURATION:
      --init                 interaktive Einrichtung: API-Key(s) fuer die
                             Rotation und Cache-TTL abfragen, Config schreiben
                             (Ziel: --config bzw. Standardpfad), dann beenden
      --api-key KEY          API-Key (Vorrang vor ABUSEIPDB_API_KEY und Config).
                             Wiederholbar: mehrere Keys werden bei erschoepftem
                             Tageskontingent (HTTP 429) der Reihe nach rotiert.
                             Auch ABUSEIPDB_API_KEY (kommasepariert) und Config
                             (api_keys=) liefern mehrere Keys.
      --config DATEI         alternative Config-Datei (Standard: ~/.config/abuseipdb/config)

CACHE:
      --cache-dir VERZ       Cache-Verzeichnis (Standard: <tool-dir>/data/cache)
      --ttl DAUER            Cache-TTL: 10d (Tage), 36h (Stunden) oder nackte
                             Zahl = Stunden (Standard: 10d)
      --no-cache             Ergebnis-Cache umgehen (immer live abfragen)
      --clear-cache          Cache (inkl. Rate-Limit-Metadatei) leeren und beenden
      --cache-stats          Cache-Statistik anzeigen und beenden

ABFRAGE:
      --parallel N           parallele Abfragen (Standard 5, Max 10, 1 = sequenziell)
      --max-age TAGE         maxAgeInDays fuer die API (Standard 90, 1-365)

AUSGABE:
      --sort KEY             score|country|isp|reports|last-reported (Standard score)
      --reverse              Sortierreihenfolge umkehren
      --no-color             farbige Ausgabe abschalten (auto-aus ohne Terminal)
      --threshold-critical N Schwelle rot (Standard 75)
      --threshold-suspect N  Schwelle gelb (Standard 25)

EXPORT:
      --output-file DATEI    Ergebnis zusaetzlich in Datei schreiben (atomar);
                             ohne Endung wird .FORMAT automatisch angehaengt
      --output-format FORMAT csv|json|jsonl|txt|md (Standard csv)

SONSTIGES:
  -h, --help             diese Hilfe anzeigen

EXIT-CODES:
  0  alle geprueften IPs unauffaellig (sauber)
  1  mindestens eine IP >= kritischem Schwellenwert
  2  Nutzungs-/Eingabe-/Abhaengigkeitsfehler
  3  API-/Netzfehler
  Prioritaet bei mehreren zutreffenden Faellen: 2 vor 3 vor 1.
EOF
}

# aic_need_arg <flag> [wert...]: prueft, ob auf <flag> ein Argument folgt.
# Rueckgabe 2 + stderr-Meldung, wenn nicht — der Aufrufer reicht den Code durch.
aic_need_arg() {
  [ "$#" -ge 2 ] || { printf 'Fehler: %s benoetigt ein Argument\n' "${1}" >&2; return 2; }
}

# aic_parse_args: befuellt globale Zustandsvariablen aus den CLI-Argumenten.
# Unbekannte Flags brechen mit Exit 2 (+ Hilfe-Hinweis) ab; `--` beendet die
# Optionsverarbeitung, der Rest wird als Positionsargumente behandelt.
aic_parse_args() {
  AIC_POSITIONAL=()
  AIC_INPUT_FILE=""
  AIC_EXTRACT=0
  AIC_EXCLUDES=()
  AIC_SHOW_HELP=0
  AIC_OPT_API_KEY=""
  AIC_OPT_API_KEYS=()
  AIC_OPT_CONFIG=""
  AIC_OPT_CACHE_DIR=""
  AIC_OPT_TTL=""
  AIC_NO_CACHE=0
  AIC_DO_CLEAR_CACHE=0
  AIC_DO_CACHE_STATS=0
  AIC_DO_INIT=0
  AIC_OPT_PARALLEL=""
  AIC_OPT_MAX_AGE=""
  AIC_OPT_SORT=""
  AIC_OPT_REVERSE=0
  AIC_OPT_NO_COLOR=0
  AIC_OPT_OUTPUT_FILE=""
  AIC_OPT_OUTPUT_FORMAT=""
  AIC_OPT_THRESHOLD_CRITICAL=""
  AIC_OPT_THRESHOLD_SUSPECT=""

  while [ "$#" -gt 0 ]; do
    case "${1}" in
      -h|--help)
        AIC_SHOW_HELP=1; shift ;;
      -f|--file)
        aic_need_arg "$@" || return 2
        AIC_INPUT_FILE="${2}"; shift 2 ;;
      --extract)
        AIC_EXTRACT=1; shift ;;
      --init)
        AIC_DO_INIT=1; shift ;;
      --exclude)
        aic_need_arg "$@" || return 2
        AIC_EXCLUDES+=("${2}"); shift 2 ;;
      --exclude-file)
        aic_need_arg "$@" || return 2
        aic_load_exclude_file "${2}" || { printf 'Fehler: Exclude-Datei nicht lesbar: %s\n' "${2}" >&2; return 2; }
        shift 2 ;;
      --api-key)
        aic_need_arg "$@" || return 2
        # Wiederholbar (F2): Reihenfolge = Prioritaet. AIC_OPT_API_KEY bleibt der
        # erste Wert (Abwaertskompatibilitaet fuer aic_resolve_api_key).
        [ -z "${AIC_OPT_API_KEY}" ] && AIC_OPT_API_KEY="${2}"
        AIC_OPT_API_KEYS+=("${2}"); shift 2 ;;
      --config)
        aic_need_arg "$@" || return 2
        AIC_OPT_CONFIG="${2}"; shift 2 ;;
      --cache-dir)
        aic_need_arg "$@" || return 2
        AIC_OPT_CACHE_DIR="${2}"; shift 2 ;;
      --ttl)
        aic_need_arg "$@" || return 2
        AIC_OPT_TTL="${2}"; shift 2 ;;
      --no-cache)
        # AIC_NO_CACHE wird vom Runner in US-008 konsumiert (Ergebnis-Cache
        # umgehen); hier bereits geparst, damit das Flag frueh verfuegbar ist.
        # shellcheck disable=SC2034
        AIC_NO_CACHE=1; shift ;;
      --clear-cache)
        AIC_DO_CLEAR_CACHE=1; shift ;;
      --cache-stats)
        AIC_DO_CACHE_STATS=1; shift ;;
      --parallel)
        aic_need_arg "$@" || return 2
        AIC_OPT_PARALLEL="${2}"; shift 2 ;;
      --max-age)
        aic_need_arg "$@" || return 2
        AIC_OPT_MAX_AGE="${2}"; shift 2 ;;
      --sort)
        aic_need_arg "$@" || return 2
        AIC_OPT_SORT="${2}"; shift 2 ;;
      --reverse)
        AIC_OPT_REVERSE=1; shift ;;
      --no-color)
        AIC_OPT_NO_COLOR=1; shift ;;
      --output-file)
        aic_need_arg "$@" || return 2
        AIC_OPT_OUTPUT_FILE="${2}"; shift 2 ;;
      --output-format)
        aic_need_arg "$@" || return 2
        AIC_OPT_OUTPUT_FORMAT="${2}"; shift 2 ;;
      --threshold-critical)
        aic_need_arg "$@" || return 2
        AIC_OPT_THRESHOLD_CRITICAL="${2}"; shift 2 ;;
      --threshold-suspect)
        aic_need_arg "$@" || return 2
        AIC_OPT_THRESHOLD_SUSPECT="${2}"; shift 2 ;;
      --)
        shift
        while [ "$#" -gt 0 ]; do AIC_POSITIONAL+=("${1}"); shift; done ;;
      -*)
        printf 'Fehler: unbekanntes Flag: %s\n' "${1}" >&2
        printf "Nutze 'abuseipdb-check --help' fuer die Hilfe.\n" >&2
        return 2 ;;
      *)
        AIC_POSITIONAL+=("${1}"); shift ;;
    esac
  done
  return 0
}

# aic_derive_finding_code: leitet den befundbasierten Exit-Code aus den
# Ergebnis-JSONs im AIC_RUN_DIR ab (VOR dem Aufraeumen aufrufen). Regeln:
#   3  mindestens ein Ergebnis mit status=="FEHLER" (API-/Netzfehler)
#   1  sonst: mindestens ein OK-Ergebnis mit abuseConfidenceScore >= kritisch
#   0  sonst (alle geprueften unauffaellig / keine Ergebnisse)
# Der Fehler-Fall hat Vorrang vor dem Kritisch-Fall (Prioritaet 3 vor 1).
# Gibt den Code als Zahl auf stdout aus und liefert immer return 0 (set -e-sicher;
# die Auswertung erfolgt beim Aufrufer ueber Kommando-Substitution).
aic_derive_finding_code() {
  local run_dir="${AIC_RUN_DIR:-}"
  local crit="${AIC_THRESHOLD_CRITICAL:-75}"
  if [ -z "${run_dir}" ] || [ ! -d "${run_dir}" ]; then
    printf '0\n'; return 0
  fi

  local -a files=()
  local f
  for f in "${run_dir}"/*.json; do
    [ -f "${f}" ] || continue
    jq -e . "${f}" >/dev/null 2>&1 || continue
    files+=("${f}")
  done
  [ "${#files[@]}" -gt 0 ] || { printf '0\n'; return 0; }

  # Ein einziger jq-Aufruf ueber alle validen Ergebnisse: FEHLER (3) schlaegt
  # kritisch (1) schlaegt sauber (0).
  local code
  code="$(jq -s --argjson crit "${crit}" '
    if any(.[]; .status == "FEHLER") then 3
    elif any(.[]; .abuseConfidenceScore != null and .abuseConfidenceScore >= $crit) then 1
    else 0 end
  ' "${files[@]}" 2>/dev/null)" || code=0
  case "${code}" in
    1|3) printf '%s\n' "${code}" ;;
    *)   printf '0\n' ;;
  esac
  return 0
}

# aic_main: Einstiegspunkt bei direkter Ausfuehrung.
aic_main() {
  aic_parse_args "$@" || return $?
  if [ "${AIC_SHOW_HELP}" -eq 1 ]; then
    aic_usage
    return 0
  fi
  aic_check_deps || return $?

  # Config laden (Flag --config uebersteuert den Standardpfad) und die
  # konfigurierte Whitelist in die Exclude-Logik uebernehmen.
  local config_path="${AIC_OPT_CONFIG:-${AIC_CONFIG_PATH}}"

  # --init: interaktive (Neu-)Einrichtung der Konfiguration, dann Ende.
  # Respektiert --config als Zielpfad; eine bestehende Datei wird nach
  # Hinweis ueberschrieben.
  if [ "${AIC_DO_INIT:-0}" -eq 1 ]; then
    if [ -f "${config_path}" ]; then
      printf 'Hinweis: bestehende Konfiguration wird ueberschrieben: %s\n' "${config_path}" >&2
    fi
    aic_config_init "${config_path}" || return 2
    return 0
  fi

  aic_load_config "${config_path}"
  [ -f "${config_path}" ] && aic_warn_insecure_config "${config_path}"
  aic_apply_config_whitelist

  # TTL-Aufloesung (F1): Flag --ttl > Config `ttl` > legacy `ttl_hours` > 240h
  # (10 Tage). Suffix d=Tage, h=Stunden, nackt=Stunden. Ungueltiger Flag-Wert
  # (0/negativ/Muell) -> Exit 2.
  local ttl_hours
  if ! ttl_hours="$(aic_resolve_ttl_hours)"; then
    printf 'Fehler: --ttl erwartet eine positive Zahl mit optionalem Suffix d (Tage) oder h (Stunden).\n' >&2
    return 2
  fi
  AIC_TTL_HOURS="${ttl_hours}"
  export AIC_TTL_HOURS

  # F3: einmalige Cache-Layout-Migration (altes <tooldir>/cache -> data/cache).
  # Nur relevant, wenn der Default-Pfad aktiv ist (weder --cache-dir noch Config
  # cache_dir uebersteuern den Cache-Ort). Best effort, kein Abbruch.
  if [ -z "${AIC_OPT_CACHE_DIR:-}" ] && [ -z "${AIC_CFG_cache_dir:-}" ]; then
    aic_migrate_cache_layout
  fi

  # Fruehe Cache-Verwaltungs-Aktionen (beenden das Programm mit Exit 0).
  if [ "${AIC_DO_CLEAR_CACHE:-0}" -eq 1 ]; then
    aic_clear_cache
    printf 'Cache geleert.\n'
    return 0
  fi
  if [ "${AIC_DO_CACHE_STATS:-0}" -eq 1 ]; then
    aic_cache_stats
    return 0
  fi

  # --parallel aufloesen/validieren: Default 5, Cap 10 (mehr -> klemmen), min 1.
  local parallel=5
  if [ -n "${AIC_OPT_PARALLEL:-}" ]; then
    if ! [[ "${AIC_OPT_PARALLEL}" =~ ^[0-9]+$ ]] || [ "${AIC_OPT_PARALLEL}" -lt 1 ]; then
      printf 'Fehler: --parallel erwartet eine Ganzzahl >= 1.\n' >&2
      return 2
    fi
    parallel="${AIC_OPT_PARALLEL}"
    if [ "${parallel}" -gt 10 ]; then
      printf 'Hinweis: --parallel auf 10 begrenzt (angefragt: %s).\n' "${parallel}" >&2
      parallel=10
    fi
  fi
  AIC_PARALLEL="${parallel}"
  export AIC_PARALLEL

  # --max-age aufloesen/validieren: Default 90, Bereich 1-365.
  local max_age=90
  if [ -n "${AIC_OPT_MAX_AGE:-}" ]; then
    if ! [[ "${AIC_OPT_MAX_AGE}" =~ ^[0-9]+$ ]] || [ "${AIC_OPT_MAX_AGE}" -lt 1 ] || [ "${AIC_OPT_MAX_AGE}" -gt 365 ]; then
      printf 'Fehler: --max-age erwartet eine Ganzzahl zwischen 1 und 365.\n' >&2
      return 2
    fi
    max_age="${AIC_OPT_MAX_AGE}"
  elif [ -n "${AIC_CFG_max_age_in_days:-}" ]; then
    max_age="${AIC_CFG_max_age_in_days}"
  fi
  AIC_MAX_AGE="${max_age}"
  export AIC_MAX_AGE

  # Schwellen aufloesen: Flag > Config > Default (75/25).
  if [ -n "${AIC_OPT_THRESHOLD_CRITICAL:-}" ]; then
    AIC_THRESHOLD_CRITICAL="${AIC_OPT_THRESHOLD_CRITICAL}"
  elif [ -n "${AIC_CFG_threshold_critical:-}" ]; then
    AIC_THRESHOLD_CRITICAL="${AIC_CFG_threshold_critical}"
  fi
  if [ -n "${AIC_OPT_THRESHOLD_SUSPECT:-}" ]; then
    AIC_THRESHOLD_SUSPECT="${AIC_OPT_THRESHOLD_SUSPECT}"
  elif [ -n "${AIC_CFG_threshold_suspect:-}" ]; then
    AIC_THRESHOLD_SUSPECT="${AIC_CFG_threshold_suspect}"
  fi
  export AIC_THRESHOLD_CRITICAL AIC_THRESHOLD_SUSPECT

  # Sortierung: --sort validieren (ungueltig -> Exit 2), --reverse uebernehmen.
  if [ -n "${AIC_OPT_SORT:-}" ]; then
    if ! aic_valid_sort_key "${AIC_OPT_SORT}"; then
      printf 'Fehler: ungueltiger --sort-Wert: %s (erlaubt: score|country|isp|reports|last-reported)\n' "${AIC_OPT_SORT}" >&2
      return 2
    fi
    AIC_SORT_KEY="${AIC_OPT_SORT}"
  fi
  AIC_SORT_REVERSE="${AIC_OPT_REVERSE:-0}"
  export AIC_SORT_KEY AIC_SORT_REVERSE

  # Farbe: --no-color erzwingt Aus; sonst Auto (TTY-Erkennung in aic_use_color).
  if [ "${AIC_OPT_NO_COLOR:-0}" -eq 1 ]; then
    AIC_COLOR=0
    export AIC_COLOR
  fi

  # Export-Format validieren (falls --output-file gesetzt): Default csv.
  local output_format="${AIC_OPT_OUTPUT_FORMAT:-csv}"
  if [ -n "${AIC_OPT_OUTPUT_FILE:-}" ]; then
    case "${output_format}" in
      csv|json|jsonl|txt|md) : ;;
      *) printf 'Fehler: ungueltiges --output-format: %s (erlaubt: csv|json|jsonl|txt|md)\n' "${output_format}" >&2
         return 2 ;;
    esac
    # Ohne Dateiendung bekommt die Ausgabedatei automatisch die Endung des
    # Export-Formats (bla -> bla.csv). Eine vom Nutzer gesetzte Endung hat
    # Vorrang und bleibt unangetastet — auch wenn sie nicht zum Format passt.
    local out_base="${AIC_OPT_OUTPUT_FILE##*/}"
    case "${out_base}" in
      ?*.*) : ;;
      *) AIC_OPT_OUTPUT_FILE="${AIC_OPT_OUTPUT_FILE}.${output_format}" ;;
    esac
  fi

  # Eingabe-Pipeline: Roh-IPs -> Dedupe -> Whitelist-Filter -> Klassen-Filter.
  # Skip-Gruende (DUPLIKAT/WHITELIST/PRIVATE/LOOPBACK/… /INVALID) laufen ueber
  # AIC_SKIP_FILE. Nur public IPs erreichen den Runner (und den Key-Zwang).
  # AIC_INPUT_COUNT_FILE zaehlt die Kandidaten VOR Dedupe/Validierung (F3).
  local skipfile ipfile inputcount
  skipfile="$(mktemp)"; export AIC_SKIP_FILE="${skipfile}"
  ipfile="$(mktemp)"
  inputcount="$(mktemp)"; printf '0' > "${inputcount}"
  export AIC_INPUT_COUNT_FILE="${inputcount}"
  aic_read_inputs | aic_dedupe | aic_filter_excluded | aic_filter_classify > "${ipfile}"

  # F1 — Kein Input -> Help statt Stille: Wurde ueberhaupt kein IP-Kandidat
  # eingelesen (weder pruefbar noch uebersprungen), liegt keine echte Eingabe
  # vor. Eigenstaendige Aktionen (--help, --clear-cache, --cache-stats,
  # interaktive Ersteinrichtung) sind oben bereits behandelt und erreichen diese
  # Stelle nicht. Meldung + Help + Exit 2.
  local input_total; input_total="$(cat "${inputcount}" 2>/dev/null)"
  [[ "${input_total}" =~ ^[0-9]+$ ]] || input_total=0
  if [ "${input_total}" -eq 0 ]; then
    printf 'Keine IPs uebergeben.\n' >&2
    aic_usage
    rm -f "${skipfile}" "${ipfile}" "${inputcount}"
    return 2
  fi

  # Nur wenn tatsaechlich IPs zu pruefen sind: Key sicherstellen + Lauf starten.
  # Der Runner rendert die Terminal-Tabelle selbst (aic_finalize_run ->
  # aic_collect_results -> aic_output). Bei --output-file exportieren wir danach
  # aus demselben AIC_RUN_DIR (dieselbe sortierte Zeilenliste).
  if [ -s "${ipfile}" ]; then
    # F2: Key-Liste aufloesen (Rotation). AIC_RUN_KEYS[] steuert die Rotation im
    # Runner; der erste Key wird als <key>-Parameter uebergeben (Signatur bleibt).
    if ! aic_ensure_api_keys; then
      rm -f "${skipfile}" "${ipfile}" "${inputcount}"
      return 2
    fi
    export AIC_NO_CACHE
    aic_run_checks_from_file "${ipfile}" "${AIC_RUN_KEYS[0]}"
  else
    # Keine zu pruefenden IPs (alles uebersprungen): reine Skip-/Leerausgabe.
    AIC_RUN_DIR="$(mktemp -d "${TMPDIR:-/tmp}/aic-run.XXXXXX")"
    export AIC_RUN_DIR
    aic_output
  fi

  # Datei-Export (nur bei --output-file). Fehler -> Exit 2.
  if [ -n "${AIC_OPT_OUTPUT_FILE:-}" ]; then
    if ! aic_export "${output_format}" "${AIC_OPT_OUTPUT_FILE}"; then
      [ -n "${AIC_RUN_DIR:-}" ] && [ -d "${AIC_RUN_DIR}" ] && rm -rf "${AIC_RUN_DIR}"
      rm -f "${skipfile}" "${ipfile}" "${inputcount}"
      return 2
    fi
  fi

  # Befundbasierten Exit-Code aus den Ergebnis-JSONs ableiten, SOLANGE das
  # Lauf-Tempdir noch existiert (Prioritaet 3 vor 1; 0 wenn alles sauber oder
  # nichts zu pruefen war). Usage-/Key-Fehler (Exit 2) sind bereits ueber
  # fruehe `return 2` behandelt und erreichen diese Stelle nicht.
  local finding_code
  finding_code="$(aic_derive_finding_code)"

  [ -n "${AIC_RUN_DIR:-}" ] && [ -d "${AIC_RUN_DIR}" ] && rm -rf "${AIC_RUN_DIR}"
  rm -f "${skipfile}" "${ipfile}" "${inputcount}"
  return "${finding_code}"
}

# Alias fuer den Source-Guard.
main() { aic_main "$@"; }

# Source-Guard: main nur bei direkter Ausfuehrung, nicht beim Sourcen (bats).
# Die if-Form (statt `&&`) sorgt dafuer, dass das Sourcen mit Exit 0 endet und
# `set -e` im sourcenden Kontext nicht ausgeloest wird.
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  main "$@"
fi
